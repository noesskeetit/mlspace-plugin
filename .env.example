# mlspace-plugin configuration — copy to a private file and select it via MLSPACE_ENV_FILE.
# Cloud.ru Key ID and Key Secret: console profile → Access keys.
# Workspace x-api-key: MLSpace profile → Develop; setup resolves it automatically.
#
# Easier: `mlspace-plugin setup` discovers workspaces and saves your selected set in
# ~/.config/mlspace-plugin/.env (mode 600) for you. Search order, least specific first:
#   ~/.config/mlspace-plugin/.env  ->  $MLSPACE_ENV_FILE  ->  the environment

# --- shared Cloud.ru access-key credentials ---
MLSPACE_CLIENT_ID=            # Key ID
MLSPACE_CLIENT_SECRET=        # Key Secret

# --- legacy singleton (used when no selected catalogue is configured) ---
MLSPACE_WORKSPACE_ID=         # x-workspace-id
# MLSPACE_API_KEY=            # optional workspace x-api-key; fetched automatically when unset

# setup writes MLSPACE_WORKSPACES as JSON: a fixed selected set, no default workspace.
# IDs must be nonblank and unique. Per-workspace keys may be resolved lazily.
# Example metadata only; use setup to configure real access, never commit credentials.
# MLSPACE_WORKSPACES='[{"id":"workspace-a","name":"A","project_name":"Project"}]'
# setup --base-url https://your-api.example saves a nonstandard endpoint; re-setup
# preserves the saved endpoint unless explicitly overridden. Production is the default.

# --- optional (defaults shown) ---
# Name a credentials file outright; it outranks the user config. Set this
# in the environment, not here — it is what points AT a file. The Agent Plugins bundle
# sets it to ${PLUGIN_DATA}/.env so per-install credentials survive plugin updates.
# MLSPACE_ENV_FILE=/path/to/.env
MLSPACE_BASE_URL=https://api.ai.cloud.ru
MLSPACE_READONLY=false                # true hides and blocks all 58 write actions
                                      # when writes are enabled, destructive actions
                                      # additionally require confirm=true
MLSPACE_TRANSPORT=streamable-http     # streamable-http | stdio
MLSPACE_HOST=127.0.0.1                # loopback only (no server-side auth in v1)
MLSPACE_PORT=8000
MLSPACE_TIMEOUT=60
# MLSPACE_ENABLED_DOMAINS=inference,jobs,notebooks   # empty = all 13 domains
# MLSPACE_LIST_DEFAULT_LIMIT=50
# MLSPACE_LIST_MAX_LIMIT=200
# MLSPACE_LOG_TAIL_LINES=200

# Optional trusted corporate CA PEM; setup copies it for persistent runtime use.
# MLSPACE_CA_FILE=/absolute/path/to/corporate-ca.pem
